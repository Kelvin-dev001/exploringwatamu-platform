# Client (Vite) environment. Copy to .env.local for local dev.

# Backend API base URL (note the /api suffix). For local dev point at your
# local backend; in production this is your deployed API.
VITE_API_URL=http://localhost:5000/api

# Google Sign-In client ID (optional; only needed for Google login)
VITE_GOOGLE_CLIENT_ID=

# Error monitoring (optional). A Sentry *browser* DSN is public by design.
# Leave empty to turn monitoring off (the SDK is then never downloaded).
# The release is taken from VERCEL_GIT_COMMIT_SHA automatically on Vercel.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
