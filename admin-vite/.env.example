# Admin portal (Vite) environment. Copy to .env.local for local dev.
# Everything here ends up in the browser bundle: never put secrets in it.

# Backend API base URL (note the /api suffix). Without it the admin talks to
# the production API on Render.
VITE_API_URL=http://localhost:5000/api

# Error monitoring (optional). A Sentry *browser* DSN is public by design.
# Leave empty to turn monitoring off (the SDK is then never downloaded).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
