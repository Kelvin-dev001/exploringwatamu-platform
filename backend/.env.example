# ---- App ----
NODE_ENV=development
PORT=5000

# ---- Database (required) ----
MONGODB_URI=

# ---- Auth (required) ----
# JWT_SECRET must be at least 16 characters. The app refuses to boot without it.
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=2d

# Admin accounts live in the database (hashed). Seed one with:
#   npm run seed:admin -- you@example.com yourStrongPassword
# ...or set these to auto-create (and keep in sync) the first admin on startup:
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- CORS / links ----
# Comma-separated extra origins allowed to call the API
FRONTEND_URLS=
# Base URL used in generated links (e-cards, receipts)
FRONTEND_URL=http://localhost:5173

# ---- Google Sign-In (only needed for /api/auth/google) ----
GOOGLE_CLIENT_ID=

# ---- Media hosting (Cloudinary) ----
# Needed for admin image uploads (group trips, hotels, tours, services, vehicles,
# properties). Set all three or none: a partial set stops the server from
# booting; none makes uploads answer 503 "Image hosting is not configured".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (SMTP) ----
# If SMTP_HOST/SMTP_USER are blank, emails are NOT sent (safe dev no-op).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ExploringWatamu <no-reply@exploringwatamu.com>
SUPPORT_EMAIL=hello@exploringwatamu.com
# Where new-booking notifications go (defaults to ADMIN_EMAIL)
ADMIN_NOTIFY_EMAIL=

# ---- SMS (Africa's Talking) ----
# Leave blank to disable SMS (messages are logged, not sent).
AT_ENV=production
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ---- Password reset ----
RESET_TOKEN_TTL_MINUTES=60

# ---- Payments (M-Pesa) ----
# Keep false for now. M-Pesa routes are gated off unless this is true.
PAYMENTS_ENABLED=false
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
# MPESA_ENV=sandbox
